# Python virtual environment
.venv/

# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Jupyter temporary files
.ipynb_checkpoints/

# Environment variables and credentials
.env
.env.*
*.key

# Raw and generated datasets
data/raw/*
data/interim/*
data/processed/*

# Generated database files
database/*.duckdb
database/*.db

# Logs
*.log

# Operating system files
.DS_Store
Thumbs.db

# Preserve empty directory structure
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!database/.gitkeep
